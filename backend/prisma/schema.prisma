generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model condolence {
  id         String   @id
  obituaryId String
  message    String
  author     String
  createdAt  DateTime @default(now())
  obituary   obituary @relation(fields: [obituaryId], references: [id], onDelete: Cascade, map: "Condolence_obituaryId_fkey")

  @@index([obituaryId], map: "Condolence_obituaryId_fkey")
}

model obituary {
  id         String       @id
  date       DateTime
  message    String
  deceased   String
  condolence condolence[]
}

model product {
  id          String        @id
  name        String
  description String
  price       Float
  stock       Int
  reservation reservation[]
}

model reservation {
  id        String   @id
  userId    String
  productId String
  status    String   @default("pending")
  createdAt DateTime @default(now())
  product   product  @relation(fields: [productId], references: [id], map: "Reservation_productId_fkey")
  user      user     @relation(fields: [userId], references: [id], map: "Reservation_userId_fkey")

  @@index([productId], map: "Reservation_productId_fkey")
  @@index([userId], map: "Reservation_userId_fkey")
}

model user {
  id          String        @id
  name        String
  email       String        @unique(map: "User_email_key")
  password    String
  role        String        @default("user")
  createdAt   DateTime      @default(now())
  reservation reservation[]
}
